# Muse-Me Environment Variables Example
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file to version control.

# Meta / Llama API Configuration (Optional)
# Supported endpoint: official Meta Llama / Muse endpoint
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3

# Muse Server Settings
MUSE_HOST=127.0.0.1
MUSE_PORT=8080
MUSE_DEBUG=false
