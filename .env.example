# Muse-Me Environment Variables Example
# Copy this file to .env or set variables directly in your environment.
# Note: The application reads variables directly from the process environment;
# it does not automatically load .env files at runtime.
# NEVER commit your actual .env file or credentials to version control.

# Meta / Llama API Configuration (Optional)
# Set MODEL_API_KEY in your process environment to enable the Meta provider adapter.
MODEL_API_KEY=

# Optional model identifier used for status and metadata reporting (default: muse-spark-1.3)
MODEL_NAME=muse-spark-1.3
