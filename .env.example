# Muse-Me Environment Variables Example
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file to version control.

# Meta / Llama API Configuration (Optional)
# Supported endpoints: official Meta Llama API or compatible OpenAI-style endpoints
MODEL_API_KEY=
MODEL_API_BASE=https://api.llama.com/v1
MODEL_NAME=Llama-3.3-70B-Instruct

# Muse Server Settings
MUSE_HOST=127.0.0.1
MUSE_PORT=8080
MUSE_DEBUG=false
